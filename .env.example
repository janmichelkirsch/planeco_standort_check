# Supabase → Project Settings → API Keys
SUPABASE_URL=https://<projekt-id>.supabase.co
# Secret Key (sb_secret_...) oder legacy service_role Key. NUR serverseitig, niemals öffentlich machen.
SUPABASE_SECRET_KEY=
# Publishable Key (sb_publishable_...) oder legacy anon Key. Für Login und Dashboard (Zugriff über RLS begrenzt).
SUPABASE_PUBLISHABLE_KEY=

# Brevo → Settings → SMTP & API → API Keys (Restricted: nur "Transactional email: All")
BREVO_API_KEY=
# In Brevo verifizierter Absender
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Planeco Standort-Check (Demo)
# Optional: öffentliche Basis-URL für das Logo in Mails. Ohne Angabe nimmt der Code auf Vercel automatisch
# VERCEL_PROJECT_PRODUCTION_URL. Lokal ohne beides steht „planeco“ als Text statt des Logos.
MAIL_ASSET_BASE_URL=
